# Copy to .env on each server and fill in. .env itself is not committed.

# Backend API base URL
VITE_BACKEND_URL=

# Host the app is served on, and the port (read by vite.config.js; not
# bundled into the app). Comma-separate several hosts if needed.
#
#   UAT (branch uat):               sandbox-billkidhar.svkm.ac.in   5173
#   Production (branch production): billkidhar.svkm.ac.in           5174
APP_ALLOWED_HOSTS=
APP_PORT=5173
